# Tailscale API token -- the automation credential for the tailnet
# (OPS-21). Create in the Tailscale admin console: Settings > Keys >
# Generate API access token. Copy to local/tailscale-api.env (chmod
# 600, gitignored). NEVER commit this file; never paste the secret
# into chat. Scopes: device/ACL management + auth keys for new nodes
# (v2 automation). Rotate: regenerate in the console + replace the
# value here.
TAILSCALE_API_TOKEN=tskey-paste-token-here
