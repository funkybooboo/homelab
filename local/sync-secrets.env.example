# template only -- copy to local/sync-secrets.env and fill
# (openssl rand -hex 32 for the secrets; URLs embed the mysql
# CT 107 sync-user password from local/mysql-secrets.env)
SYNC_MASTER_SECRET=<hex>
SYNC_TOKENSERVER__FXA_METRICS_HASH_SECRET=<hex>
SYNC_STORAGE__DATABASE_URL=mysql://sync:<pw>@192.168.1.20:3306/syncstorage
SYNC_TOKENSERVER__DATABASE_URL=mysql://sync:<pw>@192.168.1.20:3306/tokenserver
SYNC_SYNCSTORAGE__DATABASE_URL=mysql://sync:<pw>@192.168.1.20:3306/syncstorage
SYNC_TOKENSERVER__FXA_OAUTH_CLIENT_SECRET=<the public oldsync client secret, see Mozilla syncserver docs>
