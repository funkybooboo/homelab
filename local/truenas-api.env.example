# Copy to local/truenas-api.env (gitignored) and fill in from the
# truenas web UI: Credentials > API Keys > Add (user: nate). The key
# authenticates the TrueNAS REST API with exactly nate's UI
# privileges -- the write channel for scripts + ansible v2.
# NEVER commit this file; never paste the key into chat.
TRUENAS_HOST=192.168.1.10
TRUENAS_API_KEY=paste-api-key-here
