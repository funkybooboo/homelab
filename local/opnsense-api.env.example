# Copy to local/opnsense-api.env (gitignored) and fill in from
# OPNsense web UI: System > Access > Users > edit your admin user >
# API keys > create keypair. NEVER commit this; never paste the secret
# into chat -- this file is the only place it lives.
OPNSENSE_HOST=192.168.1.1
OPNSENSE_KEY=paste-api-key-here
OPNSENSE_SECRET=paste-api-secret-here
