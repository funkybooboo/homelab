# Secrets -- never commit
.env
.env.*
*.env
!.env.example
*.key
*.pem
*.crt
*.p12
*.pfx

# Filled-in unit files (the .example templates are tracked; the real ones
# contain NTFY_TOKEN / BRIDGE_PATH / NTFY_TOPIC secrets)
ntfy-slack-bridge.service

# Runtime / data
*.db
*.sqlite*
__pycache__/
*.py[cod]
*.log
*.bak
*.tmp
*.swp
.DS_Store
# Local-only (not tracked): credentials the agent uses against live
# systems; every real env file is documented by an .example sibling
# (see local/README.md)
local/*
!local/*.example
!local/README.md

# Extraction output (contains old-fleet secrets; tier-0 insurance copy
# must never be committed)
legacy-extraction/
