# /etc/ntfy-publish.env -- shared ntfy publisher credentials for PVE hosts
# + TrueNAS. Deployed to every PVE host at /etc/ntfy-publish.env (mode 0600,
# root:root). Sourced by services/observability/ntfy-publish.sh.
#
# THIS IS A TEMPLATE -- replace the values below and deploy the filled copy
# OUT OF BAND (scp). Never commit a filled copy.
#
# NTFY_TOPIC: the unguessable phone topic the ntfy app subscribes to.
# NTFY_TOKEN: a long-lived ntfy access token with write permission on
#             NTFY_TOPIC (minted on ntfy CT 128 with `ntfy token add`).
# NTFY_URL:   (optional) ntfy base URL. Defaults to the tailnet serve front.

NTFY_TOPIC=homelab-REPLACE_ME
NTFY_TOKEN=tk_REPLACE_ME
# NTFY_URL=https://ntfy.tail54538d.ts.net
