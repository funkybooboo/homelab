# Managed by make converge (container_guest role). The image is
# digest-pinned; updates roll via roll-pins.sh rewriting the
# manifest digest, never a floating tag.
#
# listen_ip: services fronted by tailnet serve stay on 127.0.0.1
# (model B); shared LAN-reachable services (mysql, the postgres
# posture) set listen_ip 0.0.0.0 in the manifest.
#
# env values of the form "env:NAME" are resolved from the
# controller environment at render time (make converge sources
# local/*-secrets.env); the task layer fails loud if one is
# missing, so this template never renders an empty secret.
services:
  app:
    image: {{ app_container.image }}@{{ app_container.digest }}
    restart: unless-stopped
    ports:
      - "{{ app_container.listen_ip | default('127.0.0.1') }}:{{ app_container.port }}:{{ app_container.target }}"
{% if app_container.volumes is defined %}
    volumes:
{% for v in app_container.volumes %}
      - "{{ v }}"
{% endfor %}
{% endif %}
{% if app_container.pid_host is defined %}
    # nsenter-controller apps only (cronmaster): the container's
    # PID namespace IS the guest's, so nsenter -t 1 reaches the CT
    pid: "host"
{% endif %}
{% if app_container.privileged is defined %}
    # required by the nsenter controller model; the blast radius is
    # the guest itself (unprivileged LXC boundary)
    privileged: true
{% endif %}
{% if app_container.env is defined %}
    environment:
{% for k, v in app_container.env.items() %}
{% if v.startswith('env:') %}
      {{ k }}: "{{ lookup('ansible.builtin.env', v[4:]) }}"
{% else %}
      {{ k }}: "{{ v }}"
{% endif %}
{% endfor %}
{% endif %}
    # stdout -> the guest journal -> promtail -> loki
    logging:
      driver: journald
